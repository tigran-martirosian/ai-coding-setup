{
  "_setup": {
    "_note": "Read by install.mjs and tests/test-wiring.mjs; never written into a settings.json. retired: hooks in ~/.claude/hooks that earlier versions wired and this one dropped (an upgrade unwires them). retiredInHomes: the same for a project folder's own .claude/hooks. oldMatchers: matcher strings an earlier version wired for a hook; an install that still has exactly one gets the current matcher.",
    "retired": ["build-nudge.mjs", "turn-cap.mjs", "web-worker-gate.mjs", "board-nudge.mjs", "worker-nudge.mjs", "loop-warn.mjs", "skill-pointer.mjs", "file-link-gate.mjs --remind"],
    "retiredInHomes": {},
    "oldMatchers": {
      "background-tasks.mjs": ["Bash|Agent|Task"],
      "repeat-guard.mjs": ["Edit|Write|Read|Bash|PowerShell|Grep|Glob|WebFetch|WebSearch"],
      "question-other.mjs": ["mcp__nimbalyst__PromptForUserInput", "mcp__nimbalyst__PromptForUserInput|mcp__nimbalyst__AskUserQuestion"],
      "job-done.mjs": ["Bash"]
    }
  },
  "subagentPromptCacheTtl": "1h",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/transcript-check.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/patch-next.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/code-review-gate.mjs --start",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/nimbalyst-notes.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/experiment-alert.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/session-cleanup.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/recheck-dates.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/background-tasks.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/agent-run-log.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task|Edit|Write|MultiEdit|NotebookEdit|mcp__nimbalyst-host__spawn_session|mcp__nimbalyst-host__send_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/no-response-gate.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/worker-size.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/big-read-gate.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/budget-gate.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/map-brief.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/serves-brief.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task|Write|mcp__nimbalyst-host__spawn_session|mcp__nimbalyst-host__create_session|mcp__nimbalyst-host__send_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/decided-quote.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__nimbalyst__PromptForUserInput|mcp__nimbalyst__AskUserQuestion|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/question-other.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__nimbalyst__display_to_user",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/picture-in-project.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__nimbalyst-browser__browser_open_session",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/browser-visible-gate.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|Read|Bash|PowerShell|Grep|Glob|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/repeat-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Agent|Task|mcp__nimbalyst__developer_git_commit_proposal",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/job-done.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/code-review-gate.mjs --pre",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/command-explain.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/sql-guard.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/delete-guard.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/long-sleep-guard.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/find-guard.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/download-guard.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(*push*)",
            "command": "node ~/.claude/hooks/push-key-scan.mjs",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(*push*)",
            "command": "node ~/.claude/hooks/push-key-scan.mjs",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*opencli*)",
            "command": "node ~/.claude/hooks/opencli-readonly.mjs",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(*opencli*)",
            "command": "node ~/.claude/hooks/opencli-readonly.mjs",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/planner-readonly.mjs",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/slow-output-gate.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/skills/steer/steer.mjs --hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/map-generated.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/session-cleanup.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/context-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__nimbalyst__developer_git_commit_proposal",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/job-done.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__nimbalyst__PromptForUserInput|mcp__nimbalyst__AskUserQuestion|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/form-answer.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/helper-stopped.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/agent-run-log.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/context-guard.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/worker-size.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/skills/steer/steer.mjs --hook",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/plan-usage-logger.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/map-drift.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/session-cleanup.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/agent-run-log.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/big-read-gate.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/context-guard.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/no-response-gate.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/pc-tidy-nudge.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/map-nudge.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/map-prompt.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/cold-cache.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/job-done.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/background-tasks.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/update-check.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/usage-dashboard-hook.mjs",
            "timeout": 200
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/plan-usage-logger.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/session-cleanup.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/link-gate.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/handoff-brief.mjs --hook",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/plan-usage-logger.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/run-yourself.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/job-done.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/code-review-gate.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/verify-gate.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/no-response-gate.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/next-step-gate.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/background-tasks.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/file-link-gate.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/context-guard.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ~/.claude/skills/steer/steer.mjs --hook",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/skills/steer/steer.mjs --watch",
            "asyncRewake": true,
            "timeout": 7200
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/web-answer-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/session-cleanup.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
