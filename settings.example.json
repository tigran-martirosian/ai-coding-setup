{
  "_setup": {
    "_note": "Read by install.mjs and tests/test-wiring.mjs; never written into a settings.json. retired: hooks in ~/.claude/hooks that earlier versions wired and this one dropped (an upgrade unwires them). retiredInHomes: the same for a project folder's own .claude/hooks. oldMatchers: matcher strings an earlier version wired for a hook; an install that still has exactly one gets the current matcher. retiredEntries: per event, hook entries an earlier version wired there that this one dropped while the file stays (a name with arguments matches only those arguments, a bare name only the entry without any); an upgrade unwires them. A hook that moved into a group of hooks/dispatch-groups.json is unwired by the dispatcher entry itself.",
    "retired": [
      "build-nudge.mjs",
      "turn-cap.mjs",
      "web-worker-gate.mjs",
      "board-nudge.mjs",
      "worker-nudge.mjs",
      "loop-warn.mjs",
      "skill-pointer.mjs",
      "file-link-gate.mjs --remind",
      "long-sleep-guard.mjs",
      "big-read-gate.mjs",
      "background-tasks.mjs",
      "slow-output-gate.mjs",
      "decided-quote.mjs",
      "serves-brief.mjs",
      "budget-gate.mjs",
      "worker-size.mjs",
      "job-done.mjs",
      "context-guard.mjs",
      "cold-cache.mjs",
      "handoff-brief.mjs",
      "next-step-gate.mjs",
      "run-yourself.mjs",
      "web-answer-gate.mjs",
      "form-answer.mjs",
      "code-review-gate.mjs",
      "upkeep-note.mjs",
      "recheck-dates.mjs",
      "patch-next.mjs",
      "pc-tidy-nudge.mjs",
      "experiment-alert.mjs",
      "map-prompt.mjs"
    ],
    "retiredInHomes": {},
    "retiredEntries": {
      "SessionStart": ["session-cleanup.mjs"],
      "PreToolUse": [
        "no-response-gate.mjs",
        "planner-readonly.mjs",
        "repeat-guard.mjs"
      ],
      "PostToolUse": ["plan-usage-logger.mjs"],
      "UserPromptSubmit": ["plan-usage-logger.mjs"]
    },
    "oldMatchers": {
      "question-other.mjs": [
        "mcp__nimbalyst__PromptForUserInput",
        "mcp__nimbalyst__PromptForUserInput|mcp__nimbalyst__AskUserQuestion"
      ]
    }
  },
  "subagentPromptCacheTtl": "1h",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/transcript-check.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/nimbalyst-notes.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/compact-handoff.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/agent-run-log.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__nimbalyst__PromptForUserInput|mcp__nimbalyst__AskUserQuestion|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/question-other.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__nimbalyst__display_to_user",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/picture-in-project.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__nimbalyst-browser__browser_open_session",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/browser-visible-gate.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/dispatch.mjs pre-tool",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*opencli*)",
            "command": "node ~/.claude/hooks/opencli-readonly.mjs",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(*opencli*)",
            "command": "node ~/.claude/hooks/opencli-readonly.mjs",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/map-generated.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/helper-stopped.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/agent-run-log.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/skills/steer/steer.mjs --hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/map-drift.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/session-cleanup.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/agent-run-log.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/dispatch.mjs prompt",
            "timeout": 200
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/update-check.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/dispatch.mjs stop",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/link-gate.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ~/.claude/skills/steer/steer.mjs --watch",
            "asyncRewake": true,
            "timeout": 7200
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/session-cleanup.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
