// The relay Worker on Cloudflare (pipe design, section 10). No Worker name and no account here: the deploy passes
// --name (phone-relay or phone-relay-test) and the account comes from CLOUDFLARE_ACCOUNT_ID. Deploy only with
// phone/relay/deploy-test.mjs or the release workflow; both first write the page into ./dist with its _headers.
// The relay's settings are Worker secrets, not vars here (worker.mjs lists them). Two optional ones are set by hand
// and kept across deploys: BUTTON_FORWARD_URL and BUTTON_FORWARD_SECRET, where the owner's `x:` button presses go.
{
  "main": "src/worker.mjs",
  "compatibility_date": "2026-04-07",
  // request.signal fires when a caller breaks off, so an aborted Send to chat cancels its upload to Telegram.
  "compatibility_flags": ["enable_request_signal"],
  // The page files are static assets, served before the Worker runs; any other path reaches worker.mjs.
  "assets": {
    "directory": "./dist"
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  // SQLite-backed: the only kind the free plan has, and the one that offers ctx.storage.kv.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // The webhook check every 5 minutes (worker.mjs `scheduled`). Both copies run it; the test copy checks nothing.
  "triggers": { "crons": ["*/5 * * * *"] }
}
