{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/package-lock.json",
      "!**/*.md",
      "!extensions/shared/orbs/orbs.js",
      "!.claude/systems-map.json",
      "!extensions/agents-panel/test/fixture.html",
      "!skills/setup-audit/scripts/usage-dashboard.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "includes": [
      "**",
      "!extensions/ink-themes/manifest.json",
      "!rules/history.json",
      "!tools/nimbalyst-patch/pin.json",
      "!version.json"
    ],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off",
        "useOptionalChain": "off"
      },
      "style": {
        "useTemplate": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noExplicitAny": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "assist": {
    "enabled": true
  },
  "css": {
    "formatter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": ["skills/update-setup/update.mjs"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
