{
  "id": "com.local.usageplan",
  "name": "Usage Plan",
  "version": "0.2.0",
  "description": "Claude plan usage and forecast in a small pop-up. Reads the local setup-audit skill; nothing leaves this computer.",
  "author": "Local",
  "main": "dist/index.js",
  "styles": "dist/index.css",
  "apiVersion": "1.0.0",
  "defaultEnabled": true,
  "permissions": {
    "filesystem": true
  },
  "contributions": {
    "panels": [
      {
        "id": "usage-plan",
        "title": "Usage Plan",
        "icon": "data_usage",
        "placement": "sidebar",
        "order": 90,
        "tooltip": "Claude plan: this week's use, the pace, and when it runs out"
      },
      {
        "id": "usage-dashboard",
        "title": "Usage dashboard",
        "icon": "bar_chart",
        "placement": "fullscreen",
        "order": 91,
        "tooltip": "The whole Claude usage dashboard."
      }
    ]
  }
}
