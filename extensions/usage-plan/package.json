{
  "name": "nimbalyst-usage-plan",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types test/command.test.ts && node --experimental-strip-types test/format.test.ts && node --experimental-strip-types test/dashboard-data.test.ts && node --experimental-strip-types test/type-levels.test.ts",
    "install-ext": "npm run build && node scripts/install.mjs"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2",
    "@nimbalyst/extension-sdk": "^0.8.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  },
  "dependencies": {
    "react": "^19.3.1"
  },
  "overrides": {
    "@nimbalyst/extension-sdk": {
      "vite": "$vite"
    }
  }
}
